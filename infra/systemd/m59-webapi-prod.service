[Unit]
Description=Meridian 59 Web API (Prod)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/m59-account-api
EnvironmentFile=/opt/m59-account-api/.env
ExecStart=/opt/m59-account-api/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 443 \
    --ssl-keyfile /etc/letsencrypt/live/www.emfiftynine.info/privkey.pem \
    --ssl-certfile /etc/letsencrypt/live/www.emfiftynine.info/fullchain.pem
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
