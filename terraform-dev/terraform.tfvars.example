# Copy this to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars to git.

do_token     = "dop_v1_YOUR_TOKEN_HERE"
ssh_key_name = "ed-key-bazzite"

# GitHub PAT — needs actions:read + contents:read scopes
github_token = "github_pat_YOUR_TOKEN_HERE"
github_org   = "roge-life"
github_repo  = "Meridian59_900_1.0"

# Droplet config
region       = "nyc3"
droplet_size = "s-1vcpu-2gb"

# Domains
domain             = "dev.emfiftynine.info"
game_server_domain = "901.emfiftynine.info"

# db_password and secret_key are auto-generated by Terraform (random_password).
# Retrieve them after apply with: terraform output db_password
